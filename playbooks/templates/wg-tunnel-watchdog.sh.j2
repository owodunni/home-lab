#!/usr/bin/env bash
# WireGuard tunnel watchdog — re-establish wg0 when its handshake goes stale.
#
# What: If wg0's latest handshake is older than the threshold (or wg0 is down),
#       restart wg-quick@wg0. That re-resolves the DDNS endpoint and re-applies
#       the gateway-pin route.
# Why:  PersistentKeepalive keeps a healthy tunnel up but never re-resolves the
#       endpoint DNS, so when the home public IP changes the tunnel is stranded
#       on a dead address with no way back on its own. A restart re-resolves it.
#       Also recovers a wg-quick that failed to start during a boot-time outage.
#
#       NB: this deliberately does NOT touch WiFi anymore. The uplink is pinned
#       to 5 GHz (stable) and wpa_supplicant re-associates by itself; the gateway
#       pin (see wg0.conf.j2) means wg0 no longer blocks WiFi recovery. So the old
#       drop-wg0 / cycle-wifi / raise-wg0 dance — which once cascaded into an
#       outage — is gone. A stuck WiFi link is rare and self-heals; if wg-quick
#       cannot resolve the endpoint while it is down, the next tick simply retries.
# Resolves: Tunnel not self-recovering after a home-IP change or boot-time fail.
set -u

WG_IFACE="wg0"
STALE_AFTER="{{ wg_watchdog_stale_seconds }}"   # secs without a handshake => down

log() { logger -t wg-tunnel-watchdog -- "$*"; }

# Newest handshake across all peers; empty/0 when wg0 is down or never handshook.
latest="$(wg show "$WG_IFACE" latest-handshakes 2>/dev/null \
          | awk '{print $2}' | sort -nr | head -1)"
now="$(date +%s)"

if [[ -n "$latest" && "$latest" -gt 0 && $((now - latest)) -lt $STALE_AFTER ]]; then
    exit 0   # tunnel healthy — nothing to do
fi

log "tunnel stale (last handshake: ${latest:-none}); restarting wg-quick@${WG_IFACE}"
systemctl restart "wg-quick@${WG_IFACE}"
log "restart issued"
