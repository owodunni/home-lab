---
# Traefik dynamic config for Garage S3 — managed by Ansible, do not edit manually.
#
# The wildcard cert (*.{{ traefik_domain }}) is managed by traefik-wildcard-tls.yml.j2
# (deployed by the ingress layer). This router just selects it via certResolver.

http:
  routers:
    garage-s3:
      rule: "Host(`s3.{{ traefik_domain }}`)"
      service: garage-s3
      tls:
        certResolver: letsencrypt

  services:
    garage-s3:
      loadBalancer:
        servers:
          - url: "http://127.0.0.1:{{ garage_s3_api_port }}"
