# {{ ansible_managed }}
# Seafile subtree NFS export — managed by playbooks/seafile.yml (do not edit).
#
# What: Re-exports the Seafile data subtree of the pool with all_squash, mapping
#       every client UID/GID (including a client's root) to the media account
#       ({{ storage_media_uid }}/{{ storage_media_gid }}).
# Why:  The Seafile image runs its /etc/my_init.d bootstrap scripts as root,
#       before the server process drops to UID {{ storage_media_uid }}. Under
#       the pool's root_squash export that root is squashed to nobody, so the
#       very first `mkdir /shared/seafile` fails ("Permission denied") and the
#       container crash-loops. all_squash forces every access on this dedicated
#       subtree to the media account, so both the root-run init and the
#       {{ storage_media_uid }}-run server can write — while the rest of the
#       pool keeps root_squash.
# Resolves: Seafile first-run crash loop on the NFS-backed /shared.
#
# IMPORTANT: the Seafile client must mount this path over NFSv3 (see
# group_vars/seafile/main.yml, seafile_nfs_version). Over NFSv4 the whole pool is
# one pseudo-filesystem and these per-subtree squash options are NOT honored for
# a subdirectory of the same filesystem — the parent's root_squash wins. NFSv3
# matches this exact export path in mountd and applies all_squash directly.
#
# fsid is an explicit non-zero value, distinct from the pool root (fsid=0): the
# pool is a FUSE/mergerfs filesystem, for which the kernel cannot auto-derive a
# stable fsid. Keep it unique across all export entries on this host.
{{ mergerfs_mount_point }}/{{ _seafile_pool_subdir }} {{ nfs_export_clients }}(rw,sync,no_subtree_check,all_squash,anonuid={{ storage_media_uid }},anongid={{ storage_media_gid }},fsid=1)
