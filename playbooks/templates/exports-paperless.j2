# {{ ansible_managed }}
# Paperless-ngx subtree NFS export — managed by playbooks/paperless.yml (do not edit).
#
# What: Re-exports the Paperless media subtree of the pool with all_squash, mapping
#       every client UID/GID (including a client's root) to the container's
#       paperless account ({{ _paperless_uid }}/{{ _paperless_gid }}).
# Why:  The Paperless container runs as UID {{ _paperless_uid }}. Under the pool's
#       default root_squash export, client root is squashed to nobody and writes fail.
#       all_squash forces every access on this dedicated subtree to the container's
#       account, so all writes succeed while the rest of the pool keeps root_squash.
# Resolves: Reliable document storage permissions on the NFS-backed media dir.
#
# fsid is 3, distinct from the pool root (fsid=0), Seafile (fsid=1), and Nextcloud (fsid=2).
{{ mergerfs_mount_point }}/{{ _paperless_pool_subdir }} {{ nfs_export_clients }}(rw,sync,no_subtree_check,all_squash,anonuid={{ _paperless_uid }},anongid={{ _paperless_gid }},fsid=3)
