# Traefik dynamic config for SilverBullet — managed by Ansible, do not edit.
#
# The wildcard cert (*.{{ traefik_domain }}) is managed by traefik-wildcard-tls.yml.j2
# (deployed by the ingress layer). This router just selects it via certResolver.
# Traefik is co-located with SilverBullet on valen, so the upstream is loopback.
#
# NOTE: NO forward-auth middleware on this router. SilverBullet authenticates
# natively — local accounts plus its own OIDC client against Authentik — and a
# browser SSO redirect would break its WebSocket sync and its bearer-token HTTP
# API / `sb` CLI. Same reasoning as Immich and Jellyfin; see silverbullet_hostname
# in group_vars/silverbullet/main.yml.
#
# No Traefik-side tuning needed for WebSockets: Traefik forwards Upgrade requests
# transparently for any HTTP/1.1 backend, so SilverBullet's live-sync socket
# passes through unmodified (same as Vaultwarden's notification websocket and
# Immich's live updates).

http:
  routers:
    silverbullet:
      rule: "Host(`{{ silverbullet_hostname }}`)"
      service: silverbullet
      tls:
        certResolver: letsencrypt

  services:
    silverbullet:
      loadBalancer:
        servers:
          - url: "http://127.0.0.1:{{ silverbullet_port }}"
