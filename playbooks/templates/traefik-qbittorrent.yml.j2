# Traefik dynamic config for qBittorrent — managed by Ansible, do not edit.
#
# The wildcard cert (*.{{ traefik_domain }}) is managed by traefik-wildcard-tls.yml.j2
# (ingress layer); this router selects it via certResolver. Traefik is co-located
# with qBittorrent on valen, so the upstream is loopback (the port gluetun
# publishes). The router is gated by the shared Authentik forward-auth middleware
# (deployed by playbooks/media-forward-auth.yml) since qBittorrent has no OIDC.

http:
  routers:
    qbittorrent:
      rule: "Host(`{{ qbittorrent_hostname }}`)"
      service: qbittorrent
      middlewares:
        - authentik-forward-auth@file
      tls:
        certResolver: letsencrypt

  services:
    qbittorrent:
      loadBalancer:
        servers:
          - url: "http://127.0.0.1:{{ qbittorrent_port }}"
