---
# Traefik static configuration — managed by Ansible, do not edit manually.
global:
  checkNewVersion: false
  sendAnonymousUsage: false

log:
  level: INFO

# Dashboard on :8080 — bound to ansible_host ({{ ansible_host | default(inventory_hostname) }})
# so it is only reachable on the management interface, not from the internet.
api:
  dashboard: true
  insecure: true

entryPoints:
  traefik:
    address: "{{ ansible_host | default(inventory_hostname) }}:8080"
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
          permanent: true
  websecure:
    address: ":443"

# Dynamic config directory — each application drops a .yml file here
providers:
  file:
    directory: /etc/traefik/conf.d
    watch: true

certificatesResolvers:
  letsencrypt:
    acme:
      email: "{{ letsencrypt_email }}"
      storage: /etc/traefik/acme.json
      dnsChallenge:
        provider: cloudflare
        # Use Cloudflare's authoritative resolvers to verify DNS propagation
        resolvers:
          - "1.1.1.1:53"
          - "8.8.8.8:53"
