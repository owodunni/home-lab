---
# Traefik static configuration — managed by Ansible, do not edit manually.
global:
  checkNewVersion: false
  sendAnonymousUsage: false

log:
  level: INFO

# Dashboard on :8080 — bound to ansible_host ({{ ansible_host | default(inventory_hostname) }})
# so it is only reachable on the management interface, not from the internet.
api:
  dashboard: true
  insecure: true

entryPoints:
  traefik:
    address: "{{ ansible_host | default(inventory_hostname) }}:8080"
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
          permanent: true
  websecure:
    address: ":443"
    # Preserve X-Forwarded-* from trusted LAN peers (e.g. valen's co-located
    # Traefik forwarding an Authentik forward-auth check) instead of scrubbing
    # them. Without this the X-Forwarded-Host is rewritten to this host, breaking
    # the forward-auth post-login redirect. See traefik_forwarded_trusted_ips.
    forwardedHeaders:
      trustedIPs:
{% for ip in traefik_forwarded_trusted_ips %}
        - "{{ ip }}"
{% endfor %}
{% if 'jellyfin_relay' in group_names %}
  # Plain-HTTP entrypoint, dedicated to jellyfin-relay.yml's catch-all router.
  # What:  A second, unencrypted listener — no redirect to websecure, unlike
  #        `web` above.
  # Why:   The TV's native Jellyfin app connects by raw IP (no hostname), so
  #        its TLS ClientHello has no SNI and it gets the defaultGeneratedCert
  #        fallback — which is valid for *.{{ traefik_domain }} but
  #        hostname-mismatched for a bare IP. A browser lets you click through
  #        that; the TV app hard-fails with no override. Dropping TLS
  #        entirely for this barn-local-only path sidesteps cert validation.
  # Resolves: TV app "connection failed" against https://<beelink-barn-ip>.
  #        See docs/superpowers/specs/2026-07-18-jellyfin-barn-relay-design.md.
  jellyfin-relay-plain:
    address: ":8096"
{% endif %}

# Dynamic config directory — each application drops a .yml file here
providers:
  file:
    directory: /etc/traefik/conf.d
    watch: true

certificatesResolvers:
  letsencrypt:
    acme:
      email: "{{ letsencrypt_email }}"
      storage: /etc/traefik/acme.json
      dnsChallenge:
        provider: cloudflare
        # Use Cloudflare's authoritative resolvers to verify DNS propagation
        resolvers:
          - "1.1.1.1:53"
          - "8.8.8.8:53"
