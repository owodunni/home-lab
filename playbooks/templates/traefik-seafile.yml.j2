# Traefik dynamic config for Seafile — managed by Ansible, do not edit manually.
#
# The wildcard cert (*.{{ traefik_domain }}) is managed by traefik-wildcard-tls.yml.j2
# (deployed by the ingress layer). This router just selects it via certResolver.
# Traefik is co-located with Seafile on this host, so the upstream is loopback.

http:
  routers:
    seafile:
      rule: "Host(`{{ seafile_hostname }}`)"
      service: seafile
      tls:
        certResolver: letsencrypt

  services:
    seafile:
      loadBalancer:
        servers:
          - url: "http://127.0.0.1:{{ seafile_port }}"
