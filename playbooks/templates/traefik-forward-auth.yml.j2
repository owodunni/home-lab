# Traefik forward-auth middleware (Authentik) — managed by Ansible, do not edit.
#
# Apps without native OIDC reference this as `authentik-forward-auth@file` in
# their router's middlewares. The address points at Authentik's embedded outpost
# via the public auth URL, which this host reaches over the network (DNS → the
# Authentik host's Traefik → loopback to Authentik:9000) — so Authentik keeps its
# loopback-only binding. Authentik uses single-application forward auth: one
# Proxy Provider per app (External host = that app's URL) so each carries its own
# group policy and the post-login redirect returns to the app, not the Authentik
# dashboard. This single middleware still covers every app — the embedded outpost
# matches the right provider by forwarded Host header. See
# docs/media-stack-migration.md for the Authentik-side setup.

http:
  middlewares:
    authentik-forward-auth:
      forwardAuth:
        address: "https://auth.{{ traefik_domain }}/outpost.goauthentik.io/auth/traefik"
        # Trust X-Forwarded-* from this Traefik so Authentik builds correct
        # redirect URLs back to the requested app.
        trustForwardHeader: true
        # Identity headers Authentik returns on success, copied onto the request
        # the backend app receives (apps that read them get the SSO user).
        authResponseHeaders:
          - X-authentik-username
          - X-authentik-groups
          - X-authentik-entitlements
          - X-authentik-email
          - X-authentik-name
          - X-authentik-uid
          - X-authentik-jwt
          - X-authentik-meta-jwks
          - X-authentik-meta-outpost
          - X-authentik-meta-provider
          - X-authentik-meta-app
          - X-authentik-meta-version
