# Traefik dynamic config for Prowlarr — managed by Ansible, do not edit.
#
# The wildcard cert (*.{{ traefik_domain }}) is managed by traefik-wildcard-tls.yml.j2
# (ingress layer); this router selects it via certResolver. Traefik is co-located
# with Prowlarr on valen, so the upstream is loopback. The router is gated by the
# shared Authentik forward-auth middleware (deployed by playbooks/media-forward-auth.yml)
# since Prowlarr has no OIDC. NOTE: the Authentik-side Expression Policy must
# bypass /api so Radarr/Sonarr can reach Prowlarr's API behind the same auth.

http:
  routers:
    prowlarr:
      rule: "Host(`{{ prowlarr_hostname }}`)"
      service: prowlarr
      middlewares:
        - authentik-forward-auth@file
      tls:
        certResolver: letsencrypt

  services:
    prowlarr:
      loadBalancer:
        servers:
          - url: "http://127.0.0.1:{{ prowlarr_port }}"
