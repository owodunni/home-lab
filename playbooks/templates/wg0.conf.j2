[Interface]
PrivateKey = {{ vault_wg_private_key }}
Address = {{ wg_address }}
{% if (wg_local_gateway | default('')) | length > 0 %}
# Subnet-collision guard. AllowedIPs includes 192.168.1.0/24 (the home LAN), but
# this host's own LAN is also 192.168.1.0/24, so wg-quick's route for it (metric
# 0) hijacks the local gateway {{ wg_local_gateway }} — killing internet AND the
# tunnel's own handshake path (the endpoint is reached via that gateway). Pin the
# gateway to the uplink with a more-specific /32 route so it stays local; the rest
# of 192.168.1.0/24 still reaches home hosts via wg0. `replace`/`|| true` keep
# up/down idempotent. See [[beelink-wifi-tunnel-recovery]] and CLAUDE.md notes.
PostUp = ip route replace {{ wg_local_gateway }}/32 dev {{ wifi_iface }} scope link
PreDown = ip route del {{ wg_local_gateway }}/32 dev {{ wifi_iface }} scope link || true

# Same collision, different symptom: a REPLY this host sends to any OTHER local
# peer on its own 192.168.1.0/24 (not just the gateway above — e.g. a barn
# relay client) also matches wg0's route and gets shoved into the tunnel
# instead of answered locally. A reply's source address is fixed to the
# address the request was sent to before the routing table is consulted, so a
# per-peer /32 pin does not scale (every new local client would need one) —
# route by SOURCE instead. Table 100 holds only the local, non-tunnel path for
# 192.168.1.0/24; the rule sends anything already sourced from this host's own
# WiFi address through it. Only affects replies to locally received traffic —
# new connections this host itself initiates (e.g. the jellyfin-relay's own
# hop to valen) still resolve their source via the main table (wg0), same as
# today. The address is looked up at PostUp time, not baked in at Ansible
# render time, so a DHCP lease change self-heals on the next tunnel-recovery
# restart with no re-run needed. See
# docs/superpowers/specs/2026-07-18-jellyfin-barn-relay-design.md.
PostUp = ip route replace 192.168.1.0/24 dev {{ wifi_iface }} scope link table 100
PostUp = ip rule add from $(ip -4 -o addr show dev {{ wifi_iface }} | awk '{print $4}' | cut -d/ -f1) lookup 100 priority 100 2>/dev/null || true
PreDown = ip rule del table 100 2>/dev/null || true
{% endif %}

[Peer]
PublicKey = {{ wg_server_public_key }}
Endpoint = {{ wg_server_endpoint }}
AllowedIPs = {{ wg_allowed_ips }}
# Keep tunnel alive through NAT — beelink initiates outbound, server can't reach it otherwise
PersistentKeepalive = 25
