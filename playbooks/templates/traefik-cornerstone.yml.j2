# Traefik dynamic config for Cornerstone — managed by Ansible, do not edit manually.
#
# The wildcard cert (*.{{ traefik_domain }}) is managed by traefik-wildcard-tls.yml.j2
# (deployed by the ingress layer). This router just selects it via certResolver.
# Traefik is co-located with Cornerstone on pi-cm5-2, so the upstream is loopback.
# No forward-auth: Cornerstone has its own Authentik OIDC SSO (native client).

http:
  routers:
    cornerstone:
      rule: "Host(`{{ cornerstone_hostname }}`)"
      service: cornerstone
      tls:
        certResolver: letsencrypt

  services:
    cornerstone:
      loadBalancer:
        servers:
          - url: "http://127.0.0.1:{{ cornerstone_port }}"
