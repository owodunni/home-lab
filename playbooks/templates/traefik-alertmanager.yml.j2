---
# Traefik dynamic config for Alertmanager — managed by Ansible, do not edit manually.
#
# The wildcard cert (*.{{ traefik_domain }}) is managed by traefik-wildcard-tls.yml.j2
# (deployed by the ingress layer). This router just selects it via certResolver.

http:
  routers:
    alertmanager:
      rule: "Host(`alertmanager.{{ traefik_domain }}`)"
      service: alertmanager
      # Gated by the shared Authentik forward-auth middleware (deployed by
      # playbooks/prometheus.yml on this host) since Alertmanager has no native
      # auth/OIDC. Prometheus reaches Alertmanager over loopback, bypassing this,
      # so alert delivery is unaffected when Authentik is down — only the UI is.
      middlewares:
        - authentik-forward-auth@file
      tls:
        certResolver: letsencrypt

  services:
    alertmanager:
      loadBalancer:
        servers:
          - url: "http://{{ alertmanager_web_listen_address }}"
