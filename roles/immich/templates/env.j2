# Immich stack environment — managed by Ansible, do not edit manually.
# Interpolated by docker compose into docker-compose.yml (${VAR} references).
# Vault source: group_vars/immich/vault.yml

# ---- Postgres ------------------------------------------------------------
DB_USERNAME={{ immich_db_username }}
DB_DATABASE_NAME={{ immich_db_database_name }}
DB_PASSWORD={{ vault_immich_db_password }}

# ---- DB-dump backup (restic -> Garage S3, bucket: immich-postgres-backup) --
# The restic password encrypts the repo — LOSING IT MAKES EVERY EXISTING
# SNAPSHOT UNRECOVERABLE. The S3 key pair (Garage format: GK + 24 hex / 64 hex)
# is the bring-your-own credential playbooks/immich.yml's Garage play imports
# into the immich-postgres-backup bucket.
DB_BACKUP_RESTIC_PASSWORD={{ vault_immich_restic_password }}
DB_BACKUP_S3_ACCESS_KEY_ID={{ vault_immich_db_backup_s3_access_key }}
DB_BACKUP_S3_SECRET_ACCESS_KEY={{ vault_immich_db_backup_s3_secret_key }}

# ---- Originals backup (restic -> Garage S3, bucket: immich-data-backup) ----
# Reuses the SAME restic password as the DB-dump repo above (separate
# buckets/keys, one password) — same convention as authentik's two repos.
DATA_BACKUP_RESTIC_PASSWORD={{ vault_immich_restic_password }}
DATA_BACKUP_S3_ACCESS_KEY_ID={{ vault_immich_data_backup_s3_access_key }}
DATA_BACKUP_S3_SECRET_ACCESS_KEY={{ vault_immich_data_backup_s3_secret_key }}
