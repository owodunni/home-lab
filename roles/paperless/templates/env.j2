# Paperless-ngx environment — managed by Ansible, do not edit manually.
# Vault source: group_vars/paperless/vault.yml

# Secret key for session tokens and signing
PAPERLESS_SECRET_KEY={{ vault_paperless_secret_key }}
PAPERLESS_URL=https://{{ paperless_hostname }}

# Database credentials
POSTGRES_DB={{ paperless_db_name }}
POSTGRES_USER={{ paperless_db_user }}
POSTGRES_PASSWORD={{ vault_paperless_pg_pass }}
PAPERLESS_DBPASS={{ vault_paperless_pg_pass }}

# Application config
PAPERLESS_TIME_ZONE={{ paperless_timezone }}
PAPERLESS_OCR_LANGUAGE={{ paperless_ocr_language }}
PAPERLESS_OCR_LANGUAGES={{ paperless_ocr_languages }}
PAPERLESS_TRUSTED_PROXIES={{ paperless_trusted_proxies }}

# Email notifications (uses cluster-wide Gmail SMTP from group_vars/all)
PAPERLESS_EMAIL_HOST={{ smtp_host }}
PAPERLESS_EMAIL_PORT={{ smtp_port }}
PAPERLESS_EMAIL_HOST_USER={{ vault_smtp_username }}
PAPERLESS_EMAIL_HOST_PASSWORD={{ vault_smtp_password }}
PAPERLESS_EMAIL_USE_TLS={{ smtp_use_tls | lower }}
PAPERLESS_EMAIL_FROM={{ smtp_from }}

# SSO — Authentik OpenID Connect
{% if paperless_oidc_enabled %}
PAPERLESS_APPS=allauth.socialaccount.providers.openid_connect
PAPERLESS_SOCIALACCOUNT_PROVIDERS={"openid_connect":{"OAUTH_PKCE_ENABLED":true,"APPS":[{"provider_id":"{{ paperless_oidc_provider_id }}","name":"authentik","client_id":"{{ paperless_oidc_client_id }}","secret":"{{ vault_paperless_oidc_client_secret }}","settings":{"server_url":"{{ paperless_oidc_discovery_uri }}","fetch_userinfo":true}}],"SCOPE":["openid","profile","email"]}}
PAPERLESS_LOGOUT_REDIRECT_URL={{ paperless_oidc_logout_redirect_url }}
PAPERLESS_SOCIAL_AUTO_SIGNUP=true
PAPERLESS_SOCIALACCOUNT_ALLOW_SIGNUPS=true
PAPERLESS_SOCIAL_ACCOUNT_SYNC_GROUPS=true
{% endif %}

# Database backup credentials (restic → Garage S3)
DB_BACKUP_RESTIC_PASSWORD={{ vault_paperless_restic_password }}
BACKUP_S3_ACCESS_KEY_ID={{ vault_paperless_backup_s3_access_key }}
BACKUP_S3_SECRET_ACCESS_KEY={{ vault_paperless_backup_s3_secret_key }}

# Media & data backup credentials (restic → Garage S3)
MEDIA_BACKUP_RESTIC_PASSWORD={{ vault_paperless_restic_password }}
MEDIA_BACKUP_S3_ACCESS_KEY_ID={{ vault_paperless_media_backup_s3_access_key }}
MEDIA_BACKUP_S3_SECRET_ACCESS_KEY={{ vault_paperless_media_backup_s3_secret_key }}
