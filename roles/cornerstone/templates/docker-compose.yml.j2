# Cornerstone docker-compose — managed by Ansible, do not edit manually.
# Non-secret values come from group_vars (Jinja); secrets come from .env.

services:
  cornerstone:
    image: {{ cornerstone_image }}
    container_name: cornerstone
    restart: unless-stopped
    env_file:
      - .env
    volumes:
      - cornerstone-data:/app/data
      - cornerstone-backups:/backups
    ports:
      # WebUI bound to loopback only — Traefik (co-located on valen) proxies
      # to it over loopback. Not exposed on the LAN.
      - "127.0.0.1:{{ cornerstone_port }}:3000"
    logging:
      driver: json-file
      options:
        max-size: "{{ cornerstone_log_max_size }}"
        max-file: "{{ cornerstone_log_max_file }}"
    healthcheck:
      test: ["CMD", "node", "-e", "fetch('http://localhost:3000/api/health').then(r=>{if(!r.ok)throw r.status}).catch(()=>process.exit(1))"]
      interval: 30s
      timeout: 5s
      start_period: 10s
      retries: 3

  # Backup sidecar — restic snapshot of /app/data (SQLite DB) → Garage S3 on
  # valen (local), mirrored offsite to beelink by the backup layer.
  # All app state is in /app/data; the /backups volume holds only Cornerstone's
  # own internal dumps and is NOT what restic snapshots here (those are consumed
  # by the app itself, not the platform backup tooling).
  data-backup:
    image: ghcr.io/lobaro/restic-backup-docker:{{ cornerstone_backup_image_version }}
    container_name: cornerstone-data-backup
    restart: unless-stopped
    environment:
      RESTIC_REPOSITORY: "s3:{{ cornerstone_backup_s3_endpoint }}/{{ cornerstone_backup_s3_bucket }}"
      RESTIC_PASSWORD: ${BACKUP_RESTIC_PASSWORD:?Variable is not set or empty}
      AWS_ACCESS_KEY_ID: ${BACKUP_S3_ACCESS_KEY_ID:?Variable is not set or empty}
      AWS_SECRET_ACCESS_KEY: ${BACKUP_S3_SECRET_ACCESS_KEY:?Variable is not set or empty}
      AWS_DEFAULT_REGION: "{{ cornerstone_backup_s3_region }}"
      RESTIC_TAG: cornerstone-data
      BACKUP_CRON: "{{ cornerstone_backup_schedule }}"
      RESTIC_FORGET_ARGS: "{{ cornerstone_backup_retention_args }}"
    volumes:
      # Read-only mount — restic only ever reads. Stored as /data/app-data in the
      # restic snapshot; the restore handler copies .restore/data/app-data back
      # over {{ cornerstone_dir }}/volumes/cornerstone-data (restore_paths).
      - cornerstone-data:/data/app-data:ro
    env_file:
      - .env

volumes:
  cornerstone-data:
  cornerstone-backups:
