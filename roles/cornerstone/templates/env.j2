# Cornerstone stack environment — managed by Ansible, do not edit manually.
# Interpolated by docker compose into docker-compose.yml (${VAR} references)
# AND loaded directly into the app container via env_file.
# Vault source: group_vars/cornerstone/vault.yml

# ---- Application settings ---------------------------------------------------
# Public-facing base URL — required for OIDC callback URL construction and
# CalDAV/CardDAV discovery behind a reverse proxy.
EXTERNAL_URL={{ cornerstone_external_url }}
# Required behind a reverse proxy: makes the app trust X-Forwarded-For so
# rate limiting (login endpoint) uses the real client IP, not 127.0.0.1.
TRUST_PROXY=true
LOG_LEVEL={{ cornerstone_log_level }}
NODE_ENV=production

# ---- Session ----------------------------------------------------------------
SESSION_DURATION={{ cornerstone_session_duration }}
SECURE_COOKIES=true
# Used to sign session tokens. Losing this invalidates all active sessions.
SESSION_SECRET={{ vault_cornerstone_session_secret }}

# ---- OIDC (Authentik) -------------------------------------------------------
# Issuer URL for Authentik format: https://<host>/application/o/<slug>/
OIDC_ISSUER={{ cornerstone_oidc_issuer }}
OIDC_CLIENT_ID={{ cornerstone_oidc_client_id }}
OIDC_CLIENT_SECRET={{ vault_cornerstone_oidc_client_secret }}
OIDC_JIT_PROVISIONING={{ cornerstone_oidc_jit_provisioning | lower }}

# ---- Paperless-ngx integration ----------------------------------------------
# Internal URL used by Cornerstone's server for API calls to Paperless.
PAPERLESS_URL={{ cornerstone_paperless_url }}
# External URL for browser-accessible "View in Paperless-ngx" deep links.
PAPERLESS_EXTERNAL_URL={{ cornerstone_paperless_external_url }}
# Paperless API token for Cornerstone's backend API calls.
PAPERLESS_API_TOKEN={{ vault_cornerstone_paperless_api_token }}

# ---- LLM (Auto-itemize / invoice-from-document) ------------------------------
# Shared OpenRouter key + model with Paperless. OpenRouter is not an
# auto-detected provider, so LLM_PROVIDER is pinned to generic.
LLM_BASE_URL={{ cornerstone_llm_base_url }}
LLM_API_KEY={{ vault_openrouter_api_key }}
LLM_MODEL={{ cornerstone_llm_model }}
LLM_PROVIDER={{ cornerstone_llm_provider }}
LLM_REQUEST_TIMEOUT_MS={{ cornerstone_llm_request_timeout_ms }}

# ---- Data backup (restic → Garage S3) ---------------------------------------
# The restic password encrypts the repo — LOSING IT MAKES EVERY EXISTING SNAPSHOT
# UNRECOVERABLE. The S3 key pair (Garage format: GK + 24 hex / 64 hex) is the
# bring-your-own credential the cornerstone.yml Garage play imports into the
# cornerstone-backup bucket.
BACKUP_RESTIC_PASSWORD={{ vault_cornerstone_restic_password }}
BACKUP_S3_ACCESS_KEY_ID={{ vault_cornerstone_backup_s3_access_key }}
BACKUP_S3_SECRET_ACCESS_KEY={{ vault_cornerstone_backup_s3_secret_key }}
