# Nextcloud environment — managed by Ansible, do not edit manually.
# Interpolated by docker compose into docker-compose.yml (${VAR} references).
# Vault source: group_vars/nextcloud/vault.yml

# ---- Database ----------------------------------------------------------------
POSTGRES_HOST={{ nextcloud_db_host }}
POSTGRES_DB={{ nextcloud_db_name }}
POSTGRES_USER={{ nextcloud_db_user }}
POSTGRES_PASSWORD={{ vault_nextcloud_pg_pass }}

# ---- Cache / file locking (Redis) -------------------------------------------
REDIS_HOST={{ nextcloud_redis_host }}
REDIS_HOST_PORT={{ nextcloud_redis_port }}
REDIS_HOST_PASSWORD={{ vault_nextcloud_redis_password }}

# ---- Server / reverse proxy --------------------------------------------------
# Trusted domains the install will accept (the public hostname). Space-separated.
NEXTCLOUD_TRUSTED_DOMAINS={{ nextcloud_hostname }}
# Data directory inside the container (the bind-mounted NFS host mount).
NEXTCLOUD_DATA_DIR=/var/www/html/data
TRUSTED_PROXIES={{ nextcloud_trusted_proxies }}
OVERWRITEHOST={{ nextcloud_overwrite_host }}
OVERWRITEPROTOCOL={{ nextcloud_overwrite_protocol }}
OVERWRITECLIURL={{ nextcloud_overwrite_cli_url }}
PHP_MEMORY_LIMIT={{ nextcloud_php_memory_limit }}
PHP_UPLOAD_LIMIT={{ nextcloud_php_upload_limit }}

# ---- Initial admin --------------------------------------------------------
# Deliberately NOT exposing NEXTCLOUD_ADMIN_USER/PASSWORD to the container: that
# would make the image entrypoint auto-install only on a pristine volume, which
# strands the instance at installed=false if a first run failed after copying the
# code. Install is run explicitly by the role (occ maintenance:install) from
# nextcloud_admin_user / vault_nextcloud_admin_password instead.

# ---- Email relay (cluster-wide Gmail SMTP from group_vars/all + shared creds) -
SMTP_HOST={{ smtp_host }}
SMTP_PORT={{ smtp_port }}
SMTP_SECURE={{ 'tls' if smtp_use_tls else ('ssl' if smtp_use_ssl else '') }}
SMTP_NAME={{ vault_smtp_username }}
SMTP_PASSWORD={{ vault_smtp_password }}
MAIL_FROM_ADDRESS={{ smtp_from.split('@')[0] }}
MAIL_DOMAIN={{ smtp_from.split('@')[1] }}

# ---- Offsite backup credentials (restic → Garage S3) -------------------------
# One restic password encrypts BOTH repos (DB + data); each is a separate
# bucket/path. Losing it makes existing snapshots unrecoverable — keep a copy
# outside this repo. Vault source: vault_nextcloud_restic_password
RESTIC_PASSWORD={{ vault_nextcloud_restic_password }}

# DB restic repo S3 key (nextcloud-backup bucket).
DB_BACKUP_S3_ACCESS_KEY_ID={{ vault_nextcloud_backup_s3_access_key }}
DB_BACKUP_S3_SECRET_ACCESS_KEY={{ vault_nextcloud_backup_s3_secret_key }}

# File-data restic repo S3 key (nextcloud-data-backup bucket).
DATA_BACKUP_S3_ACCESS_KEY_ID={{ vault_nextcloud_data_backup_s3_access_key }}
DATA_BACKUP_S3_SECRET_ACCESS_KEY={{ vault_nextcloud_data_backup_s3_secret_key }}
