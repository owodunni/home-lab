# Jellyseerr stack environment — managed by Ansible, do not edit manually.
# Interpolated by docker compose into docker-compose.yml (${VAR} references).
# Vault source: group_vars/jellyseerr/vault.yml
#
# Jellyseerr itself needs no secret env (TZ/LOG_LEVEL are non-secret Jinja values;
# the Jellyfin/Radarr/Sonarr API keys and OIDC client secret are entered in the
# WebUI and stored in its config DB); the only secrets here drive the
# config-backup sidecar.

# ---- config backup (restic → Garage S3) --------------------------------------
# The restic password encrypts the repo — LOSING IT MAKES EVERY EXISTING SNAPSHOT
# UNRECOVERABLE. The S3 key pair (Garage format: GK + 24 hex / 64 hex) is the
# bring-your-own credential the jellyseerr.yml Garage play imports into the
# jellyseerr-backup bucket.
BACKUP_RESTIC_PASSWORD={{ vault_jellyseerr_restic_password }}
BACKUP_S3_ACCESS_KEY_ID={{ vault_jellyseerr_backup_s3_access_key }}
BACKUP_S3_SECRET_ACCESS_KEY={{ vault_jellyseerr_backup_s3_secret_key }}
