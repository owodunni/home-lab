# Jellyseerr — media request/discovery UI. Managed by Ansible, do not edit
# manually. Non-secret values come from group_vars (Jinja); secrets come from .env.

services:
  jellyseerr:
    image: {{ jellyseerr_image }}
    container_name: jellyseerr
    restart: unless-stopped
    environment:
      - TZ={{ media_time_zone }}
      - LOG_LEVEL={{ jellyseerr_log_level }}
    volumes:
      - {{ jellyseerr_config_dir }}:/app/config
    ports:
      # HTTP published on loopback only — Traefik (co-located on valen) proxies to
      # it. No forward-auth middleware on the router: Jellyseerr has its own login
      # and native OIDC (see jellyseerr_hostname note in group_vars).
      - "127.0.0.1:{{ jellyseerr_port }}:{{ jellyseerr_port }}"
    logging:
      driver: json-file
      options:
        max-size: "{{ jellyseerr_log_max_size }}"
        max-file: "{{ jellyseerr_log_max_file }}"
    networks:
      # Shared media network so Prowlarr reaches Radarr/Sonarr (Apps sync) by
      # container name — off the public forward-auth'd URL. See group_vars/media
      # → media_docker_*.
      - media

  # Offsite backup of Jellyseerr's config — the Jellyfin/Radarr/Sonarr connections,
  # the user accounts/permissions, request history and OIDC settings, all configured
  # by hand. A restic snapshot of it on a schedule → Garage S3 on beelink (offsite,
  # over WireGuard), so that wiring is captured ONCE and survives a host/disk loss
  # (restore-any-snapshot via the generic tooling: make verify-backups /
  # restore-backups SERVICE=jellyseerr). Read-only mount — restic only ever reads.
  config-backup:
    image: ghcr.io/lobaro/restic-backup-docker:{{ jellyseerr_backup_image_version }}
    container_name: jellyseerr-config-backup
    restart: unless-stopped
    environment:
      RESTIC_REPOSITORY: "s3:{{ jellyseerr_backup_s3_endpoint }}/{{ jellyseerr_backup_s3_bucket }}"
      RESTIC_PASSWORD: ${BACKUP_RESTIC_PASSWORD:?Variable is not set or empty}
      AWS_ACCESS_KEY_ID: ${BACKUP_S3_ACCESS_KEY_ID:?Variable is not set or empty}
      AWS_SECRET_ACCESS_KEY: ${BACKUP_S3_SECRET_ACCESS_KEY:?Variable is not set or empty}
      AWS_DEFAULT_REGION: "{{ jellyseerr_backup_s3_region }}"
      RESTIC_TAG: jellyseerr-config
      BACKUP_CRON: "{{ jellyseerr_backup_schedule }}"
      RESTIC_FORGET_ARGS: "{{ jellyseerr_backup_retention_args }}"
    volumes:
      # restic stores this as source path /data/config; the restore handler copies
      # .restore/data/config back over {{ jellyseerr_config_dir }} (restore_paths).
      - {{ jellyseerr_config_dir }}:/data/config:ro
    env_file:
      - .env
    networks:
      # Same media network (it has normal internet egress) so this stack creates
      # no extra default bridge; the sidecar reaches Garage S3 over it.
      - media

networks:
  media:
    name: "{{ media_docker_network }}"
    external: true
