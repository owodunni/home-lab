# Authentik docker-compose stack — managed by Ansible, do not edit manually.
# Secrets are injected via .env (templated from vault vars).
# Based on: https://docs.goauthentik.io/docs/install-config/install/docker-compose

services:
  postgresql:
    image: docker.io/library/postgres:16-alpine
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -d $${POSTGRES_DB} -U $${POSTGRES_USER}"]
      start_period: 20s
      interval: 30s
      retries: 5
      timeout: 5s
    volumes:
      - database:/var/lib/postgresql/data
    environment:
      POSTGRES_PASSWORD: ${PG_PASS}
      POSTGRES_USER: authentik
      POSTGRES_DB: authentik

  # Redis removed in Authentik 2025.10: cache, embedded outpost, and websocket
  # state moved to Postgres, so no Redis service/host config is needed.
  server:
    image: ghcr.io/goauthentik/server:{{ authentik_version }}
    restart: unless-stopped
    command: server
    environment:
      AUTHENTIK_POSTGRESQL__HOST: postgresql
      AUTHENTIK_POSTGRESQL__USER: authentik
      AUTHENTIK_POSTGRESQL__NAME: authentik
      AUTHENTIK_POSTGRESQL__PASSWORD: ${PG_PASS}
    volumes:
      - ./media:/media
      - ./custom-templates:/templates
    env_file:
      - .env
    ports:
      - "127.0.0.1:{{ authentik_port }}:9000"
    depends_on:
      postgresql:
        condition: service_healthy

  worker:
    image: ghcr.io/goauthentik/server:{{ authentik_version }}
    restart: unless-stopped
    command: worker
    environment:
      AUTHENTIK_POSTGRESQL__HOST: postgresql
      AUTHENTIK_POSTGRESQL__USER: authentik
      AUTHENTIK_POSTGRESQL__NAME: authentik
      AUTHENTIK_POSTGRESQL__PASSWORD: ${PG_PASS}
    # Root user needed for Docker socket access (Outpost management)
    user: root
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - ./media:/media
      - ./certs:/certs
      - ./custom-templates:/templates
    env_file:
      - .env
    depends_on:
      postgresql:
        condition: service_healthy

  # DB backup, half 1 of 2: produce a logical dump on a schedule.
  # Writes pg_dump custom-format output to the shared db-dump volume; the
  # db-backup restic sidecar below snapshots that volume to Garage S3. Splitting
  # "make the dump" from "snapshot it" lets the DB ride restic's GFS retention
  # and per-snapshot restore, exactly like the file volumes. Image tag must
  # match the postgres major version above (16) so pg_dump/pg_restore are
  # wire-compatible with the server.
  # Restore is driven by the generic tooling: make restore-backups SERVICE=authentik
  #   (full guide + safe verification drill: docs/restore_postgres.md)
  pg-dump:
    image: docker.io/library/postgres:16-alpine
    restart: unless-stopped
    environment:
      PGHOST: postgresql
      PGDATABASE: authentik
      PGUSER: authentik
      PGPASSWORD: ${PG_PASS}
    volumes:
      - db-dump:/dump
    # Dump immediately on start, then every interval. Write to a temp file and
    # atomically rename so the restic sidecar never snapshots a half-written
    # dump. -Fc (custom format) so restore can pg_restore --clean --if-exists.
    entrypoint:
      - /bin/sh
      - -c
      - |
        while true; do
          pg_dump -Fc -f /dump/authentik.dump.tmp \
            && mv -f /dump/authentik.dump.tmp /dump/authentik.dump \
            && echo "pg-dump: wrote /dump/authentik.dump at $$(date -Is)"
          sleep {{ authentik_db_dump_interval_seconds }}
        done
    depends_on:
      postgresql:
        condition: service_healthy

  # DB backup, half 2 of 2: restic snapshot of the dump → Garage S3 on valen (local; mirrored offsite)
  # (beelink at the barn, over WireGuard). Repo lives under the restic/ subpath
  # of the authentik-backup bucket; reuses the bucket's existing S3 key. The
  # mount is read-only — restic only ever reads the dump.
  db-backup:
    image: ghcr.io/lobaro/restic-backup-docker:{{ authentik_volumes_backup_image_version }}
    restart: unless-stopped
    environment:
      RESTIC_REPOSITORY: "s3:{{ authentik_backup_s3_endpoint }}/{{ authentik_backup_s3_bucket }}/restic"
      RESTIC_PASSWORD: ${DB_BACKUP_RESTIC_PASSWORD}
      AWS_ACCESS_KEY_ID: ${BACKUP_S3_ACCESS_KEY_ID}
      AWS_SECRET_ACCESS_KEY: ${BACKUP_S3_SECRET_ACCESS_KEY}
      AWS_DEFAULT_REGION: "{{ authentik_backup_s3_region }}"
      RESTIC_TAG: authentik-db
      BACKUP_CRON: "{{ authentik_db_backup_schedule }}"
      RESTIC_FORGET_ARGS: "{{ authentik_db_backup_retention_args }}"
    volumes:
      - db-dump:/data:ro
    env_file:
      - .env
    depends_on:
      - pg-dump

  # Periodic restic backup of file-based volumes (media, certs,
  # custom-templates) → Garage S3 on valen (local; mirrored offsite), alongside the db-backup snapshot above.
  # Mounts are read-only: restic only ever reads the live data.
  # Restore procedure: docs/restore_volumes.md
  volumes-backup:
    image: ghcr.io/lobaro/restic-backup-docker:{{ authentik_volumes_backup_image_version }}
    restart: unless-stopped
    environment:
      RESTIC_REPOSITORY: "s3:{{ authentik_backup_s3_endpoint }}/{{ authentik_volumes_backup_s3_bucket }}"
      RESTIC_PASSWORD: ${VOLUMES_BACKUP_RESTIC_PASSWORD}
      AWS_ACCESS_KEY_ID: ${VOLUMES_BACKUP_S3_ACCESS_KEY_ID}
      AWS_SECRET_ACCESS_KEY: ${VOLUMES_BACKUP_S3_SECRET_ACCESS_KEY}
      AWS_DEFAULT_REGION: "{{ authentik_backup_s3_region }}"
      RESTIC_TAG: authentik-volumes
      BACKUP_CRON: "{{ authentik_volumes_backup_schedule }}"
      RESTIC_FORGET_ARGS: "{{ authentik_volumes_backup_retention_args }}"
    volumes:
      - ./media:/data/media:ro
      - ./certs:/data/certs:ro
      - ./custom-templates:/data/custom-templates:ro
    env_file:
      - .env

volumes:
  database:
    driver: local
  # Shared between pg-dump (writes the dump) and db-backup (reads it for restic).
  db-dump:
    driver: local
