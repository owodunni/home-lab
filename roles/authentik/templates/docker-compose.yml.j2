# Authentik docker-compose stack — managed by Ansible, do not edit manually.
# Secrets are injected via .env (templated from vault vars).
# Based on: https://docs.goauthentik.io/docs/install-config/install/docker-compose

services:
  postgresql:
    image: docker.io/library/postgres:16-alpine
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -d $${POSTGRES_DB} -U $${POSTGRES_USER}"]
      start_period: 20s
      interval: 30s
      retries: 5
      timeout: 5s
    volumes:
      - database:/var/lib/postgresql/data
    environment:
      POSTGRES_PASSWORD: ${PG_PASS}
      POSTGRES_USER: authentik
      POSTGRES_DB: authentik

  redis:
    image: docker.io/library/redis:alpine
    command: --save 60 1 --loglevel warning
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "redis-cli ping | grep PONG"]
      start_period: 20s
      interval: 30s
      retries: 5
      timeout: 3s
    volumes:
      - redis:/data

  server:
    image: ghcr.io/goauthentik/server:{{ authentik_version }}
    restart: unless-stopped
    command: server
    environment:
      AUTHENTIK_REDIS__HOST: redis
      AUTHENTIK_POSTGRESQL__HOST: postgresql
      AUTHENTIK_POSTGRESQL__USER: authentik
      AUTHENTIK_POSTGRESQL__NAME: authentik
      AUTHENTIK_POSTGRESQL__PASSWORD: ${PG_PASS}
    volumes:
      - ./media:/media
      - ./custom-templates:/templates
    env_file:
      - .env
    ports:
      - "127.0.0.1:{{ authentik_port }}:9000"
    depends_on:
      postgresql:
        condition: service_healthy
      redis:
        condition: service_healthy

  worker:
    image: ghcr.io/goauthentik/server:{{ authentik_version }}
    restart: unless-stopped
    command: worker
    environment:
      AUTHENTIK_REDIS__HOST: redis
      AUTHENTIK_POSTGRESQL__HOST: postgresql
      AUTHENTIK_POSTGRESQL__USER: authentik
      AUTHENTIK_POSTGRESQL__NAME: authentik
      AUTHENTIK_POSTGRESQL__PASSWORD: ${PG_PASS}
    # Root user needed for Docker socket access (Outpost management)
    user: root
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - ./media:/media
      - ./certs:/certs
      - ./custom-templates:/templates
    env_file:
      - .env
    depends_on:
      postgresql:
        condition: service_healthy
      redis:
        condition: service_healthy

  # Periodic pg_dump → offsite Garage S3 (beelink at the barn, reached over WireGuard). Image tag must match the postgres major version above (16).
  # To restore: docker compose run --rm pg-backup restore (see eeshugerman/postgres-backup-s3 README)
  pg-backup:
    image: eeshugerman/postgres-backup-s3:16
    restart: unless-stopped
    environment:
      SCHEDULE: "{{ authentik_backup_schedule }}"
      BACKUP_KEEP_DAYS: "{{ authentik_backup_keep_days }}"
      S3_REGION: "{{ authentik_backup_s3_region }}"
      S3_BUCKET: "{{ authentik_backup_s3_bucket }}"
      S3_PREFIX: "{{ authentik_backup_s3_prefix }}"
      # Custom S3 endpoint — Garage, reached via Traefik (not AWS)
      S3_ENDPOINT: "{{ authentik_backup_s3_endpoint }}"
      POSTGRES_HOST: postgresql
      POSTGRES_DATABASE: authentik
      POSTGRES_USER: authentik
      POSTGRES_PASSWORD: ${PG_PASS}
      S3_ACCESS_KEY_ID: ${BACKUP_S3_ACCESS_KEY_ID}
      S3_SECRET_ACCESS_KEY: ${BACKUP_S3_SECRET_ACCESS_KEY}
{% if authentik_backup_passphrase_enabled %}
      # GPG passphrase for at-rest encryption of backup files
      PASSPHRASE: ${BACKUP_PASSPHRASE}
{% endif %}
    env_file:
      - .env
    depends_on:
      postgresql:
        condition: service_healthy

volumes:
  database:
    driver: local
  redis:
    driver: local
