# Authentik docker-compose stack — managed by Ansible, do not edit manually.
# Secrets are injected via .env (templated from vault vars).
# Based on: https://docs.goauthentik.io/docs/install-config/install/docker-compose

services:
  postgresql:
    image: docker.io/library/postgres:16-alpine
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -d $${POSTGRES_DB} -U $${POSTGRES_USER}"]
      start_period: 20s
      interval: 30s
      retries: 5
      timeout: 5s
    volumes:
      - database:/var/lib/postgresql/data
    environment:
      POSTGRES_PASSWORD: ${PG_PASS}
      POSTGRES_USER: authentik
      POSTGRES_DB: authentik

  # Redis removed in Authentik 2025.10: cache, embedded outpost, and websocket
  # state moved to Postgres, so no Redis service/host config is needed.
  server:
    image: ghcr.io/goauthentik/server:{{ authentik_version }}
    restart: unless-stopped
    command: server
    environment:
      AUTHENTIK_POSTGRESQL__HOST: postgresql
      AUTHENTIK_POSTGRESQL__USER: authentik
      AUTHENTIK_POSTGRESQL__NAME: authentik
      AUTHENTIK_POSTGRESQL__PASSWORD: ${PG_PASS}
    volumes:
      - ./media:/media
      - ./custom-templates:/templates
    env_file:
      - .env
    ports:
      - "127.0.0.1:{{ authentik_port }}:9000"
    depends_on:
      postgresql:
        condition: service_healthy

  worker:
    image: ghcr.io/goauthentik/server:{{ authentik_version }}
    restart: unless-stopped
    command: worker
    environment:
      AUTHENTIK_POSTGRESQL__HOST: postgresql
      AUTHENTIK_POSTGRESQL__USER: authentik
      AUTHENTIK_POSTGRESQL__NAME: authentik
      AUTHENTIK_POSTGRESQL__PASSWORD: ${PG_PASS}
    # Root user needed for Docker socket access (Outpost management)
    user: root
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - ./media:/media
      - ./certs:/certs
      - ./custom-templates:/templates
    env_file:
      - .env
    depends_on:
      postgresql:
        condition: service_healthy

  # Periodic pg_dump → offsite Garage S3 (beelink at the barn, reached over WireGuard). Image tag must match the postgres major version above (16).
  # Restore (destructive) on the running sidecar: docker compose exec pg-backup sh restore.sh — full guide + safe verification drill: docs/restore_postgres.md
  pg-backup:
    image: eeshugerman/postgres-backup-s3:16
    restart: unless-stopped
    environment:
      SCHEDULE: "{{ authentik_backup_schedule }}"
      BACKUP_KEEP_DAYS: "{{ authentik_backup_keep_days }}"
      S3_REGION: "{{ authentik_backup_s3_region }}"
      S3_BUCKET: "{{ authentik_backup_s3_bucket }}"
      S3_PREFIX: "{{ authentik_backup_s3_prefix }}"
      # Custom S3 endpoint — Garage, reached via Traefik (not AWS)
      S3_ENDPOINT: "{{ authentik_backup_s3_endpoint }}"
      POSTGRES_HOST: postgresql
      POSTGRES_DATABASE: authentik
      POSTGRES_USER: authentik
      POSTGRES_PASSWORD: ${PG_PASS}
      S3_ACCESS_KEY_ID: ${BACKUP_S3_ACCESS_KEY_ID}
      S3_SECRET_ACCESS_KEY: ${BACKUP_S3_SECRET_ACCESS_KEY}
{% if authentik_backup_passphrase_enabled %}
      # GPG passphrase for at-rest encryption of backup files
      PASSPHRASE: ${BACKUP_PASSPHRASE}
{% endif %}
    env_file:
      - .env
    depends_on:
      postgresql:
        condition: service_healthy

  # Periodic restic backup of file-based volumes (media, certs,
  # custom-templates) → offsite Garage S3, alongside the pg-backup dump above.
  # Mounts are read-only: restic only ever reads the live data.
  # Restore procedure: docs/restore_volumes.md
  volumes-backup:
    image: ghcr.io/lobaro/restic-backup-docker:{{ authentik_volumes_backup_image_version }}
    restart: unless-stopped
    environment:
      RESTIC_REPOSITORY: "s3:{{ authentik_backup_s3_endpoint }}/{{ authentik_volumes_backup_s3_bucket }}"
      RESTIC_PASSWORD: ${VOLUMES_BACKUP_RESTIC_PASSWORD}
      AWS_ACCESS_KEY_ID: ${VOLUMES_BACKUP_S3_ACCESS_KEY_ID}
      AWS_SECRET_ACCESS_KEY: ${VOLUMES_BACKUP_S3_SECRET_ACCESS_KEY}
      AWS_DEFAULT_REGION: "{{ authentik_backup_s3_region }}"
      RESTIC_TAG: authentik-volumes
      BACKUP_CRON: "{{ authentik_volumes_backup_schedule }}"
      RESTIC_FORGET_ARGS: "{{ authentik_volumes_backup_retention_args }}"
    volumes:
      - ./media:/data/media:ro
      - ./certs:/data/certs:ro
      - ./custom-templates:/data/custom-templates:ro
    env_file:
      - .env

volumes:
  database:
    driver: local
