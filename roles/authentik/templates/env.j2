# Authentik environment — managed by Ansible, do not edit manually.
# Vault source: group_vars/authentik/vault.yml

# Database password (max 99 chars; PostgreSQL limit)
PG_PASS={{ vault_authentik_pg_pass }}

# Signing key — must be kept stable; changing it invalidates all sessions
AUTHENTIK_SECRET_KEY={{ vault_authentik_secret_key }}

# Email relay (uses cluster-wide Gmail SMTP from group_vars/all)
AUTHENTIK_EMAIL__HOST={{ smtp_host }}
AUTHENTIK_EMAIL__PORT={{ smtp_port }}
AUTHENTIK_EMAIL__FROM={{ smtp_from }}
AUTHENTIK_EMAIL__USE_TLS={{ smtp_use_tls | lower }}

# Disable Sentry error reporting (home lab, no external telemetry)
AUTHENTIK_ERROR_REPORTING__ENABLED=false

# Offsite S3 backup credentials for pg-backup sidecar (Garage on beelink, barn site)
# Vault source: group_vars/authentik/vault.yml — vault_authentik_backup_s3_access_key / vault_authentik_backup_s3_secret_key
BACKUP_S3_ACCESS_KEY_ID={{ vault_authentik_backup_s3_access_key }}
BACKUP_S3_SECRET_ACCESS_KEY={{ vault_authentik_backup_s3_secret_key }}
{% if authentik_backup_passphrase_enabled %}
BACKUP_PASSPHRASE={{ vault_authentik_backup_passphrase }}
{% endif %}

# Offsite S3 backup credentials for volumes-backup sidecar (restic, Garage on
# beelink, barn site)
# Vault source: group_vars/authentik/vault.yml —
# vault_authentik_volumes_backup_s3_access_key / _secret_key
VOLUMES_BACKUP_S3_ACCESS_KEY_ID={{ vault_authentik_volumes_backup_s3_access_key }}
VOLUMES_BACKUP_S3_SECRET_ACCESS_KEY={{ vault_authentik_volumes_backup_s3_secret_key }}

# Restic repository encryption password — restic always encrypts, this key is
# required to decrypt/restore. Vault source: vault_authentik_restic_password
VOLUMES_BACKUP_RESTIC_PASSWORD={{ vault_authentik_restic_password }}
