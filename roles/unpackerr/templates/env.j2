# Unpackerr stack environment — managed by Ansible, do not edit manually.
# Interpolated by docker compose into docker-compose.yml (${VAR} references).
# Vault source: group_vars/unpackerr/vault.yml
#
# The only secrets Unpackerr needs are the *arr API keys it authenticates with
# (everything else — URLs, paths, delays — is non-secret Jinja in the compose
# file). Each key is the value from the app's Settings → General → API Key.
UN_SONARR_0_API_KEY={{ vault_unpackerr_sonarr_api_key }}
UN_RADARR_0_API_KEY={{ vault_unpackerr_radarr_api_key }}
