# qBittorrent stack environment — managed by Ansible, do not edit manually.
# Interpolated by docker compose into docker-compose.yml (${VAR} references).
# Vault source: group_vars/qbittorrent/vault.yml

# ---- ProtonVPN (OpenVPN) credentials -----------------------------------------
# The username MUST carry the +pmp suffix for NAT-PMP port forwarding, e.g.
# "abcd1234+pmp". Without it ProtonVPN will not forward a port and torrents stay
# unconnectable.
OPENVPN_USER={{ vault_protonvpn_username }}
OPENVPN_PASSWORD={{ vault_protonvpn_password }}

# ---- qBittorrent WebUI password ----------------------------------------------
# Used by the port-manager sidecar to authenticate to the WebUI API (only needed
# if "Bypass authentication for clients on localhost" is off). Set this same
# value as the WebUI password in qBittorrent after first start.
QBITTORRENT_PASS={{ vault_qbittorrent_password }}

# ---- config backup (restic → Garage S3) --------------------------------------
# Consumed by the config-backup sidecar. The restic password encrypts the repo —
# LOSING IT MAKES EVERY EXISTING SNAPSHOT UNRECOVERABLE. The S3 key pair (Garage
# format: GK + 24 hex / 64 hex) is the bring-your-own credential the
# qbittorrent.yml Garage play imports into the qbittorrent-backup bucket.
BACKUP_RESTIC_PASSWORD={{ vault_qbittorrent_restic_password }}
BACKUP_S3_ACCESS_KEY_ID={{ vault_qbittorrent_backup_s3_access_key }}
BACKUP_S3_SECRET_ACCESS_KEY={{ vault_qbittorrent_backup_s3_secret_key }}
