# SilverBullet stack environment — managed by Ansible, do not edit manually.
# Interpolated by docker compose into docker-compose.yml (${VAR} references).
# Vault source: group_vars/silverbullet/vault.yml
#
# The SilverBullet container itself consumes NO variables from here — it has no
# secret env (its OIDC client secret is entered in the Dashboard and stored in
# the data folder). These exist solely for the data-backup sidecar.

# ---- data backup (restic → Garage S3) ----------------------------------------
# The restic password encrypts the repo — LOSING IT MAKES EVERY EXISTING SNAPSHOT
# UNRECOVERABLE. The S3 key pair (Garage format: GK + 24 hex / 64 hex) is the
# bring-your-own credential the silverbullet.yml Garage play imports into the
# silverbullet-backup bucket.
BACKUP_RESTIC_PASSWORD={{ vault_silverbullet_restic_password }}
BACKUP_S3_ACCESS_KEY_ID={{ vault_silverbullet_backup_s3_access_key }}
BACKUP_S3_SECRET_ACCESS_KEY={{ vault_silverbullet_backup_s3_secret_key }}
