# Vaultwarden environment — managed by Ansible, do not edit manually.
# Interpolated by docker compose into docker-compose.yml (${VAR} references).
# Vault source: group_vars/vaultwarden/vault.yml
#
# NOTE: keep secret values free of '$' — docker compose interprets it in ${VAR}
# references. The generated pg password is hex (safe); keep the Authentik client
# secret alphanumeric (Authentik's default URL-safe secret is fine).

# ---- App ↔ database -----------------------------------------------------------
# Vaultwarden connects to Postgres via DATABASE_URL (Postgres backend, not the
# default SQLite — see group_vars/vaultwarden/main.yml).
DATABASE_URL=postgresql://{{ vaultwarden_db_user }}:{{ vault_vaultwarden_pg_pass }}@{{ vaultwarden_db_host }}:5432/{{ vaultwarden_db_name }}

# ---- Postgres container + pg-dump sidecar ------------------------------------
POSTGRES_HOST={{ vaultwarden_db_host }}
POSTGRES_DB={{ vaultwarden_db_name }}
POSTGRES_USER={{ vaultwarden_db_user }}
POSTGRES_PASSWORD={{ vault_vaultwarden_pg_pass }}

# ---- SSO (Authentik OIDC) -----------------------------------------------------
# Must equal the client secret set on the Authentik provider (docs/vaultwarden.md).
SSO_CLIENT_SECRET={{ vault_vaultwarden_oidc_client_secret }}

# ---- Email relay (cluster-wide Gmail SMTP from group_vars/all + shared creds) -
SMTP_USERNAME={{ vault_smtp_username }}
SMTP_PASSWORD={{ vault_smtp_password }}

# ---- Offsite backup credentials (restic → Garage S3) -------------------------
# One restic password encrypts BOTH repos (DB + data); each is a separate
# bucket/path. Losing it makes existing snapshots unrecoverable — keep a copy
# outside this repo. Vault source: vault_vaultwarden_restic_password
RESTIC_PASSWORD={{ vault_vaultwarden_restic_password }}

# DB restic repo S3 key (vaultwarden-backup bucket).
DB_BACKUP_S3_ACCESS_KEY_ID={{ vault_vaultwarden_backup_s3_access_key }}
DB_BACKUP_S3_SECRET_ACCESS_KEY={{ vault_vaultwarden_backup_s3_secret_key }}

# Data-dir restic repo S3 key (vaultwarden-data-backup bucket).
DATA_BACKUP_S3_ACCESS_KEY_ID={{ vault_vaultwarden_data_backup_s3_access_key }}
DATA_BACKUP_S3_SECRET_ACCESS_KEY={{ vault_vaultwarden_data_backup_s3_secret_key }}
