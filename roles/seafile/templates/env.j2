# Seafile environment — managed by Ansible, do not edit manually.
# Interpolated by docker compose into docker-compose.yml (${VAR} references).
# Vault source: group_vars/seafile/vault.yml

# ---- Database ----------------------------------------------------------------
# Root password is only used on first-ever startup to create the databases.
INIT_SEAFILE_MYSQL_ROOT_PASSWORD={{ vault_seafile_mysql_root_password }}
SEAFILE_MYSQL_DB_HOST={{ seafile_db_host }}
SEAFILE_MYSQL_DB_PORT=3306
SEAFILE_MYSQL_DB_USER={{ seafile_db_user }}
SEAFILE_MYSQL_DB_PASSWORD={{ vault_seafile_mysql_db_password }}
SEAFILE_MYSQL_DB_CCNET_DB_NAME={{ seafile_ccnet_db }}
SEAFILE_MYSQL_DB_SEAFILE_DB_NAME={{ seafile_seafile_db }}
SEAFILE_MYSQL_DB_SEAHUB_DB_NAME={{ seafile_seahub_db }}

# ---- Cache (Redis) -----------------------------------------------------------
CACHE_PROVIDER=redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD={{ vault_seafile_redis_password }}

# ---- Server ------------------------------------------------------------------
# Protocol is https because Traefik terminates TLS upstream; hostname drives the
# absolute URLs Seafile generates and its allowed-hosts/CSRF origins.
SEAFILE_SERVER_HOSTNAME={{ seafile_hostname }}
SEAFILE_SERVER_PROTOCOL={{ seafile_server_protocol }}
TIME_ZONE={{ seafile_time_zone }}

# Signing key for internal JWTs (fileserver, AI). Must stay stable — rotating it
# invalidates issued tokens.
JWT_PRIVATE_KEY={{ vault_seafile_jwt_private_key }}

# Run as the non-root seafile user (UID/GID 8000) so NFS writes to the
# root_squash pool export succeed. See group_vars/seafile/main.yml.
NON_ROOT={{ seafile_non_root | lower }}

# Logs to stdout (Docker json-file) instead of files on NFS — see main.yml.
SEAFILE_LOG_TO_STDOUT={{ seafile_log_to_stdout | lower }}

# ---- Optional components (off for the minimal first deploy) -------------------
ENABLE_SEADOC={{ seafile_enable_seadoc | lower }}
ENABLE_NOTIFICATION_SERVER={{ seafile_enable_notification_server | lower }}

# ---- Initial admin (only applied on first-ever startup) ----------------------
INIT_SEAFILE_ADMIN_EMAIL={{ seafile_admin_email }}
INIT_SEAFILE_ADMIN_PASSWORD={{ vault_seafile_admin_password }}
