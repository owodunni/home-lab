# Prowlarr — indexer/tracker manager. Managed by Ansible, do not edit manually.
# Non-secret values come from group_vars (Jinja); secrets come from .env.

services:
  prowlarr:
    image: {{ prowlarr_image }}
    container_name: prowlarr
    restart: unless-stopped
    environment:
      - PUID={{ media_puid }}
      - PGID={{ media_pgid }}
      - TZ={{ media_time_zone }}
    volumes:
      - {{ prowlarr_config_dir }}:/config
    ports:
      # WebUI/API published on loopback only — Traefik (co-located on valen)
      # proxies to it. No VPN: Prowlarr talks to public indexers (internet egress
      # via the media bridge) and to the *arr apps over the shared media network,
      # none of which should egress the torrent VPN.
      - "127.0.0.1:{{ prowlarr_port }}:{{ prowlarr_port }}"
    networks:
      # Shared media network so Prowlarr reaches Radarr/Sonarr (Apps sync) by
      # container name — off the public forward-auth'd URL. See group_vars/media
      # → media_docker_*.
      - media
    logging:
      driver: json-file
      options:
        max-size: "{{ prowlarr_log_max_size }}"
        max-file: "{{ prowlarr_log_max_file }}"

  # Offsite backup of Prowlarr's /config — the settings DB holding the indexer
  # set, their credentials, the Radarr/Sonarr app connections, and the API key:
  # all configured by hand. A restic snapshot of it on a schedule → Garage S3 on
  # beelink (offsite, over WireGuard), so that setup is captured ONCE and survives
  # a host/disk loss (restore-any-snapshot via the generic tooling:
  # make verify-backups / restore-backups SERVICE=prowlarr). Read-only mount —
  # restic only ever reads config.
  config-backup:
    image: ghcr.io/lobaro/restic-backup-docker:{{ prowlarr_backup_image_version }}
    container_name: prowlarr-config-backup
    restart: unless-stopped
    environment:
      RESTIC_REPOSITORY: "s3:{{ prowlarr_backup_s3_endpoint }}/{{ prowlarr_backup_s3_bucket }}"
      RESTIC_PASSWORD: ${BACKUP_RESTIC_PASSWORD:?Variable is not set or empty}
      AWS_ACCESS_KEY_ID: ${BACKUP_S3_ACCESS_KEY_ID:?Variable is not set or empty}
      AWS_SECRET_ACCESS_KEY: ${BACKUP_S3_SECRET_ACCESS_KEY:?Variable is not set or empty}
      AWS_DEFAULT_REGION: "{{ prowlarr_backup_s3_region }}"
      RESTIC_TAG: prowlarr-config
      BACKUP_CRON: "{{ prowlarr_backup_schedule }}"
      RESTIC_FORGET_ARGS: "{{ prowlarr_backup_retention_args }}"
    volumes:
      # restic stores this as source path /data/config; the restore handler copies
      # .restore/data/config back over {{ prowlarr_config_dir }} (restore_paths).
      - {{ prowlarr_config_dir }}:/data/config:ro
    env_file:
      - .env
    networks:
      # Same media network (it has normal internet egress) so this stack creates
      # no extra default bridge; the sidecar reaches Garage S3 over it.
      - media

networks:
  media:
    name: "{{ media_docker_network }}"
    external: true
