# rclone config — managed by Ansible (roles/backup_mirror), do not edit manually.
#
# A single S3 remote pointing at valen's Garage with a READ-ONLY key, so this
# offsite node can only pull. Garage supports path-style requests; provider
# "Other" leaves rclone's defaults, which Garage accepts.
[garage]
type = s3
provider = Other
access_key_id = {{ vault_backup_mirror_s3_access_key }}
secret_access_key = {{ vault_backup_mirror_s3_secret_key }}
endpoint = {{ backup_mirror_endpoint }}
region = {{ backup_mirror_region }}
