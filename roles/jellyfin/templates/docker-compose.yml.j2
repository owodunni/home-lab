# Jellyfin — media server with Intel QuickSync transcoding. Managed by Ansible,
# do not edit manually. Non-secret values come from group_vars (Jinja); secrets
# come from .env.

services:
  jellyfin:
    image: {{ jellyfin_image }}
    container_name: jellyfin
    restart: unless-stopped
    environment:
      - PUID={{ media_puid }}
      - PGID={{ media_pgid }}
      - TZ={{ media_time_zone }}
    # Map the Intel render node into the container for VA-API/QSV transcoding.
    devices:
      - /dev/dri:/dev/dri
    # Add the host's video/render groups (GIDs discovered by gpu-drivers.yml and
    # stored as a local fact) so the container's media user can open /dev/dri.
    # Replaces the K8s supplementalGroups / Intel device-plugin approach.
    group_add:
      - "{{ ansible_local.media_gpu.video_gid }}"
      - "{{ ansible_local.media_gpu.render_gid }}"
    volumes:
      - {{ jellyfin_config_dir }}:/config
      # Library mounted read-only — Jellyfin streams from it but never writes to
      # it (metadata lives in /config). Only the *arr library subtree, not the
      # torrents dirs.
      - {{ jellyfin_media_dir }}:/media:ro
{% if jellyfin_mount_host_va_drivers %}
      # ---- host VA-API driver overrides (jellyfin_mount_host_va_drivers=true) --
      # Bind the host's newer Intel driver stack over the container's bundled
      # copies. Only enable after confirming these host paths exist on valen and
      # that QSV fails without them (see group_vars/jellyfin/main.yml).
      - {{ jellyfin_va_dri_host }}:/usr/lib/jellyfin-ffmpeg/lib/dri:ro
      - {{ jellyfin_va_libdir_host }}:/usr/lib/jellyfin-ffmpeg/lib/onevpl-host:ro
      - {{ jellyfin_va_libmfxgen_host }}:/usr/lib/jellyfin-ffmpeg/lib/libmfx-gen:ro
      - {{ jellyfin_va_igdgmm_host }}:{{ jellyfin_va_igdgmm_host }}:ro
{% endif %}
    ports:
      # HTTP published on loopback only — Traefik (co-located on valen) proxies to
      # it. No forward-auth middleware on the router: native Jellyfin clients
      # cannot follow an SSO redirect (see jellyfin_hostname note in group_vars).
      - "127.0.0.1:{{ jellyfin_port }}:{{ jellyfin_port }}"
    logging:
      driver: json-file
      options:
        max-size: "{{ jellyfin_log_max_size }}"
        max-file: "{{ jellyfin_log_max_file }}"

  # Offsite backup of Jellyfin's /config — users, library definitions, transcoding
  # settings, plugins and API keys, all configured by hand. A restic snapshot of it
  # on a schedule → Garage S3 on beelink (offsite, over WireGuard), so that setup is
  # captured ONCE and survives a host/disk loss (restore-any-snapshot via the
  # generic tooling: make verify-backups / restore-backups SERVICE=jellyfin).
  # Read-only mount — restic only ever reads config. (The dir also holds the
  # re-fetchable metadata/image cache; restic dedupes so incrementals stay small.)
  config-backup:
    image: ghcr.io/lobaro/restic-backup-docker:{{ jellyfin_backup_image_version }}
    container_name: jellyfin-config-backup
    restart: unless-stopped
    environment:
      RESTIC_REPOSITORY: "s3:{{ jellyfin_backup_s3_endpoint }}/{{ jellyfin_backup_s3_bucket }}"
      RESTIC_PASSWORD: ${BACKUP_RESTIC_PASSWORD:?Variable is not set or empty}
      AWS_ACCESS_KEY_ID: ${BACKUP_S3_ACCESS_KEY_ID:?Variable is not set or empty}
      AWS_SECRET_ACCESS_KEY: ${BACKUP_S3_SECRET_ACCESS_KEY:?Variable is not set or empty}
      AWS_DEFAULT_REGION: "{{ jellyfin_backup_s3_region }}"
      RESTIC_TAG: jellyfin-config
      BACKUP_CRON: "{{ jellyfin_backup_schedule }}"
      RESTIC_FORGET_ARGS: "{{ jellyfin_backup_retention_args }}"
    volumes:
      # restic stores this as source path /data/config; the restore handler copies
      # .restore/data/config back over {{ jellyfin_config_dir }} (restore_paths).
      - {{ jellyfin_config_dir }}:/data/config:ro
    env_file:
      - .env
