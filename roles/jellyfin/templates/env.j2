# Jellyfin stack environment — managed by Ansible, do not edit manually.
# Interpolated by docker compose into docker-compose.yml (${VAR} references).
# Vault source: group_vars/jellyfin/vault.yml
#
# Jellyfin itself needs no secret env (PUID/PGID/TZ are non-secret Jinja values;
# OIDC/SSO, if used, is configured in the WebUI); the only secrets here drive the
# config-backup sidecar.

# ---- config backup (restic → Garage S3) --------------------------------------
# The restic password encrypts the repo — LOSING IT MAKES EVERY EXISTING SNAPSHOT
# UNRECOVERABLE. The S3 key pair (Garage format: GK + 24 hex / 64 hex) is the
# bring-your-own credential the jellyfin.yml Garage play imports into the
# jellyfin-backup bucket.
BACKUP_RESTIC_PASSWORD={{ vault_jellyfin_restic_password }}
BACKUP_S3_ACCESS_KEY_ID={{ vault_jellyfin_backup_s3_access_key }}
BACKUP_S3_SECRET_ACCESS_KEY={{ vault_jellyfin_backup_s3_secret_key }}
